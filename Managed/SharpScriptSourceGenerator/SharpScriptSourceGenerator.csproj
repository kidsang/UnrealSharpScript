<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsRoslynComponent>true</IsRoslynComponent>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<!-- RS2008: analyzer release tracking is not needed for this in-tree generator.
		     RSEXPERIMENTAL002: SemanticModel.GetInterceptableLocation / InterceptableLocation still carry
		     the experimental marker even though the C# interceptors feature is stable in .NET 10 / C# 14.
		     The BlueprintNativeEvent call-site interceptor generator uses that stable API. -->
		<NoWarn>$(NoWarn);RS2008;RSEXPERIMENTAL002</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" PrivateAssets="all" />
	</ItemGroup>

</Project>
