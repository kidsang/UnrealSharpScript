<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<IsTrimmable>False</IsTrimmable>
		<IsAotCompatible>True</IsAotCompatible>
		<Configurations>Debug;Release;Debug_Editor;Release_Editor</Configurations>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug_Editor'">
		<DebugSymbols>true</DebugSymbols>
		<DefineConstants>$(DefineConstants);WITH_EDITOR</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release_Editor'">
	  	<Optimize>True</Optimize>
		<DefineConstants>$(DefineConstants);WITH_EDITOR</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="UnrealEngine.Globals">
			<Static>True</Static>
		</Using>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../SharpScript/SharpScript.csproj" />
		<Analyzer Include="../../Binaries/Managed/SharpScriptSourceGenerator.dll" />
	</ItemGroup>

</Project>
